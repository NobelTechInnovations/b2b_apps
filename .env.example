# ── shared by every service (each service also reads its own overrides) ──────
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Option A — Supabase (or any single Postgres): set DATABASE_URL. Every service
# then gets its own schema in it (nexus_identity, nexus_crm, …).
# Use Supabase's Supavisor TRANSACTION pooler (port 6543): it is IPv4 (the
# direct db.<ref>.supabase.co host is IPv6-only) and multiplexes connections.
# URL-encode special characters in the password (@ → %40).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Connections per service. Supabase free projects allow 60 in total.
# DB_POOL_MAX=2
# Verify the server certificate (paste Supabase's CA PEM, \n for newlines):
# PG_SSL_CA=

# Option B — local docker-compose Postgres (pnpm infra:up): leave DATABASE_URL
# unset and one database per service is used.
PG_HOST=localhost
PG_PORT=5433
PG_USER=nexus
PG_PASSWORD=nexus

# ── Event bus ────────────────────────────────────────────────────────────────
# postgres: events live in the database (schema nexus_bus) — no NATS to run.
# Unset: NATS JetStream at NATS_URL (docker-compose provides it).
BUS_DRIVER=postgres
NATS_URL=nats://localhost:4222

# ── Secrets: generate fresh values for every environment ────────────────────
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COOKIE_SECRET=dev-cookie-secret-change-me-at-least-32-chars-long
SERVICE_TOKEN=dev-internal-service-token-change-me

TOKEN_ISSUER=http://localhost:4001
JWKS_URL=http://localhost:4001/.well-known/jwks.json

# ── Web addresses ────────────────────────────────────────────────────────────
WEB_PORT=3000
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Where the web app's /api proxy sends requests (the gateway).
API_URL=http://localhost:4000
# Hostinger managed Node hosting: set true with PORT=3000 so the entry process
# listens immediately, while the gateway boots privately on port 4000.
# Leave false for Railway/Docker. This does not remove hosting process limits.
API_STARTUP_PROXY=false

# Company subdomains: each company works at <slug>.<root>, e.g.
# acme-4821.nexusapp.in. Leave empty to run everything on one host.
# Locally, lvh.me resolves every subdomain to 127.0.0.1:
#   ROOT_DOMAIN=lvh.me:3000  NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000  COOKIE_DOMAIN=lvh.me
#   APP_URL=http://lvh.me:3000  WEB_ORIGIN=http://lvh.me:3000
ROOT_DOMAIN=
NEXT_PUBLIC_ROOT_DOMAIN=
# Shares sign-in across the apex and all company subdomains (the root domain,
# without port). Required when subdomains are on.
COOKIE_DOMAIN=
# Secure cookies (HTTPS only). Always true in production.
COOKIE_SECURE=false

# Public path of the refresh endpoint, as the browser sees it (via the gateway).
REFRESH_COOKIE_PATH=/api/auth

# Signups allowed per IP per hour. Keep this low in production.
REGISTER_PER_HOUR=10

# ── Billing (platform subscriptions) ─────────────────────────────────────────
# Razorpay (https://dashboard.razorpay.com → Settings → API keys, Webhooks).
# Webhook URL: https://<api-host>/api/billing-webhooks/razorpay
# events: payment.captured, order.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local development only: "pay" invoices without Razorpay. Never in production.
BILLING_TEST_MODE=true
# Free trial for new subscriptions, in days (0 = pay before you start).
TRIAL_DAYS=14
# Days of access after a term ends unpaid, before apps lock.
BILLING_GRACE_DAYS=3
BILLING_GST_RATE=0.18
BILLING_COMPANY_NAME=Nexus

# ── Email (invitations, verification, password reset) ───────────────────────
# Any SMTP provider. Either separate settings (ZeptoMail shown) or one URL.
# Unset = the email and its link are written to the notifier's log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_URL=smtps://user:password@smtp.resend.com:465
# Must be on a domain verified with the provider.
MAIL_FROM=Nexus <no-reply@example.com>

# ── Leads: Meta (Facebook & Instagram) lead ads ─────────────────────────────
# Optional. Without these, each workspace's connected Page is checked for new
# leads every 15 minutes with its own Page token. With them, Meta pushes each
# lead the moment it is submitted: in your Meta app's Webhooks settings,
# subscribe the Page object's `leadgen` field to
# https://<your-domain>/api/lead-hooks/meta with the same verify token.
META_APP_SECRET=
META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v23.0
