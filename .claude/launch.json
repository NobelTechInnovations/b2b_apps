{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nexus/web",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_ROOT_DOMAIN=",
        "ROOT_DOMAIN=",
        "NEXT_DIST_DIR=.next-local",
        "pnpm",
        "--filter",
        "@nexus/web",
        "exec",
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3200"
      ],
      "port": 3200
    }
  ]
}
